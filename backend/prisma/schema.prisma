// VayuGuard Prisma Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model SystemHealth {
  id        Int      @id @default(autoincrement())
  service   String   @default("backend")
  status    String   @default("ok")
  checkedAt DateTime @default(now())
}

model SensorReading {
  id        String   @id @default(uuid())
  location  String
  pm25      Float
  pm10      Float
  aqi       Int
  timestamp DateTime @default(now())
}

model AirQualityReading {
  id          String   @id @default(uuid())
  location    String
  latitude    Float
  longitude   Float
  pm25        Float
  pm10        Float
  co          Float
  no2         Float
  so2         Float
  o3          Float
  aqi         Int
  aqiCategory String
  temperature Float
  humidity    Float
  recordedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([location])
  @@index([recordedAt])
  @@index([aqi])
  @@index([location, recordedAt])
}
